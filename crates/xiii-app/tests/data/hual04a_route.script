t=79.60 fire
t=80.00 fire
t=80.40 fire
t=80.80 fire
t=81.20 fire
t=81.60 fire
t=82.00 track off
t=80.60 goto -3260 -1600
t=82.00 goto -3380 -2400
t=84.00 goto -3440 -3000
t=86.00 goto -3455 -3230
# The alerted third canyon soldier (BaseSoldier0) charges the stand; crouch and
# kill it there so it does not whittle the player down on the walk-out.
t=86.60 crouch 1
t=86.10 switch_weapon 11
t=86.20 reload
t=88.40 track BaseSoldier0 0.85
t=88.60 fire
