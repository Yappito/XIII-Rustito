# The lever sight spot: 'touchmanette' (TT8, crossed at t~136) has armed CWndFocusTrigger3,
# whose comic-strip window on CWndTarget1 is open (FocusDuration -1, infinite). The player
# aims at the lever (yaw 90 above, 4195,-5371 -> 4489,-5437) and uses it: the handle swings
# ('Open', MoveTime 1 s), 'Goal_Manette_Pont' fires goal 555, case 555 sees bYaDuJus and
# TGSDummy 546, and 'PontA' closes the panels (MoveTime 4 s) and ends the focus window
# through the trigger's own WaitEndFocus.
t=155.00 use XIIIMover6
# Labelled teleport (measured cabanon-exit wedge, see header), then north around the poste
# and east across the CLOSED bridge (x 4765..6232 panels + static GR_pont ramps).
t=160.00 teleport 4150 -5380 -97
t=163.00 goto 4150 -5180
t=166.50 goto 4560 -5030
# Labelled teleport (item53b combat adaptation, see header): past the lethal mid-bridge
# stretch, landing inside TouchTrigger6 so its touch still fires.
t=168.00 teleport 6133 -4949 -105
# East platform (GR_bidons04) around the stilt baraque_fin building.
t=170.00 goto 6650 -4960
t=173.50 goto 7100 -5250
t=177.00 goto 7500 -5350
t=180.50 goto 7900 -5400
t=184.00 goto 8150 -5800
# Labelled teleport into the sealed dam-base shaft top (measured seal, see header): the fall
# delivers Trigger2's touch -> 'End_of_level' -> objective 0 -> TestGoalComplete -> DoTravel
# -> the game's own Hual01b travel request (measured at t=196.5 in the item52 runs).
t=187.00 teleport 8416 -6720 -380
# Wait for the game's own travel (Hual01b via the end-of-level chain).
t=195.00 wait_travel
