t=55.50 forward 0
t=56.00 goto 3350 -1100
t=57.00 goto 3350 -750
t=58.00 use Porte15
t=82.00 use Porte15
t=82.50 crouch 1
t=83.00 goto 3350 -825
t=84.00 goto 3510 -825
t=85.00 goto 3600 -820
t=85.80 crouch 0
t=86.00 track BreakableMover7
t=87.00 fire
t=87.30 track off
t=87.30 yaw 270
t=87.30 pitch -32
t=87.60 fire
t=88.20 fire
