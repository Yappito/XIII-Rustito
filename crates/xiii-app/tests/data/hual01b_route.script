t=50.00 teleport -1183 -3450 -1015
t=50.00 forward 0
t=50.50 goto -1183 -3450
t=52.00 track BreakAbleMover1
t=52.50 fire
t=53.10 fire
t=53.70 fire
t=54.50 track off
