# (3600,-1121.2,-1075.3) firing spot)
t=55.50 teleport 3600 -1310 -1050
t=55.50 forward 0
t=56.00 goto 3600 -1150
t=59.00 track BreakableMover7
t=59.50 fire
t=60.10 fire
t=60.70 fire
t=61.50 track off
# generator 3 (baraque yard, north-middle chain): walked the whole way, break by hand
t=62.50 goto 3606 -2110
t=67.50 goto 2664 -2306
t=73.00 goto 2472 -2315
t=77.50 goto 1546 -2320
t=82.50 goto 1135 -3122
t=94.50 goto 898 -3105
t=98.50 goto 612 -2714
t=102.50 goto 602 -2602
t=106.50 goto 651 -218
t=114.00 goto 70 511
t=118.50 goto 595 694
t=122.50 goto 501 1048
t=126.50 goto 790 1453
t=130.50 goto 619 2070
t=135.00 goto 620 2552
t=139.00 goto 889 2566
# the baraque pocket's east side is sealed: the yard walk slides on the StaticMeshActor1
# slope and presses StaticMeshActor46 at (441,2756) (route v6 t=147-156 and the v1 run
# t=188-196, both measured); the teleport lands on probe gen3_gen2b's pocket start
t=147.00 teleport -150 2700 -1070
t=147.00 forward 0
t=147.50 goto -110 2790
t=152.00 track BreakableMover9
t=152.50 fire
t=153.10 fire
t=153.70 fire
t=154.50 track off
# generator 2 (west cliff): the pocket/spur seal is measured; the yaw-0 fire clips the
# compteur and the game's own break chain runs
t=158.50 teleport -4852 2300 -880
t=158.50 forward 0
t=159.00 yaw 0
t=159.00 pitch 0
t=159.50 fire
t=160.10 fire
t=160.70 fire
# ladder base (TouchTrigger0 r300 zone): the east return past the spur is measured sealed
t=162.00 teleport 3300 3000 -1020
t=162.00 forward 0
t=162.50 goto 3266 3250
# terrain hole onto the GR_sortie deck
t=167.00 goto 4024 -3100
t=177.00 goto 4024 -3760
t=187.00 goto 4024 -3829
t=190.00 forward 0
# crawl room -> tunnel -> grille punch -> shaft -> travel: the deck-to-room seal is measured
t=190.50 teleport 4023 -3700 -1360
t=190.50 forward 0
t=191.50 crouch on
t=192.00 goto 4023 -3140
t=202.00 goto 4480 -3120
t=210.00 yaw 0
t=210.50 fire
t=211.10 fire
t=211.70 fire
t=213.00 goto 4650 -3120
