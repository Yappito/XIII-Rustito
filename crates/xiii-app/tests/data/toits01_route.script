t=134.00 fire
t=135.50 fire
t=137.00 track BaseSoldier4 0.85
t=138.50 fire
t=140.00 fire
t=141.00 goto -3140 1180
t=142.00 track BaseSoldier 0.85
t=143.00 fire
t=144.00 fire
t=145.00 fire
t=146.00 fire
t=147.00 fire
t=148.00 fire
t=149.00 track off
t=150.00 forward 0
