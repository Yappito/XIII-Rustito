t=234.50 goto -4557.0 -12080.8
t=240.60 goto -4011.9 -12352.8
t=244.50 goto -3731.0 -12423.8
t=247.40 goto -3602.6 -12453.4
t=254.00 goto -2941.9 -12662.5
t=263.40 goto -2029.2 -13286.1
